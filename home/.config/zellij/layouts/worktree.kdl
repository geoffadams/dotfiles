layout {
    pane_template name="status" {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    default_tab_template {
        children
        status size=1
    }

    tab {
        pane split_direction="vertical" {
            pane size="50%" name="editor" command="nvim" focus=true
            pane size="50%" split_direction="horizontal" {
                pane size="50%" name="claude" command="zsh" {
                    args "-lic" "exec devcontainer exec --workspace-folder . claude"
                }
                pane size="50%" name="shell"
            }
        }
    }
}
