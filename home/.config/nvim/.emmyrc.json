{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua",
      "lua/?.lua",
      "lua/?/init.lua",
      "plugin/?.lua",
      "ftplugin/?.lua",
      "after/?.lua",
      "after/?/?.lua",
      "spec/?.lua"
    ]
  },
  "diagnostics": {
    "globals": [
      "vim"
    ]
  },
  "workspace": {
    "library": [
      "$HOME/.local/share/nvim/lazy",
      "$VIMRUNTIME",
      "/opt/homebrew/share/nvim/runtime/pack/dist/opt"
    ],
    "ignoreGlobs": [
      "**/*_spec.lua",
      "**/tests/**/*.lua",
      "lua/plugins/*.lua"
    ]
  }
}
