#!/usr/bin/env zsh
# Open a git worktree as a new tab in the current Zellij session, split into
# nvim + `devcontainer exec claude` + a shell.
#
# Usage: zellij-worktree [dir]
#   <dir>  worktree directory; if omitted, pick from `git worktree list`
#          via an fzf popup
set -euo pipefail

layout="$HOME/.config/zellij/layouts/worktree.kdl"

if [[ $# -gt 1 ]]; then
    echo "usage: ${0:t} [worktree-dir]" >&2
    exit 1
fi

if [[ -z ${ZELLIJ:-} ]]; then
    echo "${0:t}: not inside a Zellij session" >&2
    exit 1
fi

pick_worktree() {
    if ! (($+commands[fzf])); then
        echo "${0:t}: fzf is required to pick a worktree" >&2
        return 1
    fi

    local magenta=$'\e[35m' cyan=$'\e[36m' reset=$'\e[0m'

    git worktree list --porcelain |
        awk -v RS= -F'\n' -v magenta="$magenta" -v cyan="$cyan" -v reset="$reset" '
            {
                path = ""; branch = ""; bare = 0
                for (i = 1; i <= NF; i++) {
                    if ($i ~ /^worktree /) path = substr($i, 10)
                    else if ($i ~ /^branch /) { branch = substr($i, 8); sub("refs/heads/", "", branch) }
                    else if ($i ~ /^detached/) branch = "(detached)"
                    else if ($i ~ /^bare/) bare = 1
                }
                if (path != "" && !bare) {
                    name = path
                    sub(/^.*\//, "", name)
                    printf "%s\t%s%s%s %s%s%s\n", path, magenta, name, reset, cyan, branch, reset
                }
            }
        ' |
        fzf --popup=center,50%,10 \
            --border-label="zellij-worktree" \
            --ansi \
            --delimiter $'\t' \
            --with-nth 2 \
            --accept-nth 1
}

if [[ $# -eq 1 ]]; then
    dir=$1
else
    dir=$(pick_worktree) || exit 1
    [[ -z $dir ]] && exit 1
fi

dir=${dir:A}

if [[ ! -d $dir ]]; then
    echo "${0:t}: no such directory: $dir" >&2
    exit 1
fi

if ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "${0:t}: not a git worktree: $dir" >&2
    exit 1
fi

zellij action new-tab \
    --layout "${layout}" \
    --cwd "$dir" \
    --name "${dir:t}"
